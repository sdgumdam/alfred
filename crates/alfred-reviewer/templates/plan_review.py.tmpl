#!/usr/bin/env python3
"""Inspect task definition — generated by alfred-reviewer (R2 plan review).

Runs the PlanVerdict scorer: judges whether a DagSpec faithfully decomposes
an OwnerRequest. Pure scorer eval — no sandbox, no agent. The reviewer model
is the eval's main model (grader 角色缺省即主模型)。
"""

import json
import re

from pydantic import BaseModel, Field
from inspect_ai import Task, task
from inspect_ai.dataset import MemoryDataset, Sample
from inspect_ai.model import GenerateConfig, ResponseSchema, get_model
from inspect_ai.scorer import Score, accuracy, scorer, stderr
from inspect_ai.util import json_schema

# ---- alfred-injected configuration (tokens replaced by alfred-reviewer) ----
# 字符串 token 注入的是 JSON 字符串字面量（值语义一致），json.loads 还原对象。
OWNER_REQUEST = json.loads(__OWNER_REQUEST_JSON__)
DAGSPEC = json.loads(__DAGSPEC_JSON__)
RUN_ID = __RUN_ID_JSON__




def _extract_json_text(text: str) -> str:
    """从模型输出中提取 JSON 文本（容忍 markdown 代码围栏/前后杂文）。

    zhipu 等网关忽略 json_schema 时会返回自由文本——强提示下仍可能用
    ```json 围栏包裹。这是解析健壮性（Pydantic 校验前），不是 provider
    专属字段拼装。先试原文，再试剥围栏，最后试首个 {...} 平衡块。
    """
    candidates = [text.strip()]
    m = re.search(r"```(?:json)?\s*(.*?)```", text, re.S)
    if m:
        candidates.append(m.group(1).strip())
    for cand in candidates:
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end > start:
        cand = text[start : end + 1]
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    return text

class PlanVerdict(BaseModel):
    pass_: bool = Field(alias="pass")
    reason: str


@scorer(metrics=[accuracy(), stderr()])
def plan_verdict_scorer():
    async def score(state, target):
        # 主模型 = 审查者模型（eval --model）
        model = get_model()
        grading_prompt = f"""You are assessing whether a plan faithfully decomposes an owner request.

[BEGIN DATA]
[Owner Request]: {json.dumps(OWNER_REQUEST, ensure_ascii=False)}
[Plan (DagSpec)]: {json.dumps(DAGSPEC, ensure_ascii=False)}
[END DATA]

Determine whether the plan faithfully serves the owner request:
- every requirement in the owner request must be addressed by the plan;
- the plan must not do things the owner did not ask for.

Respond ONLY with a JSON object of exactly this shape:
{{"pass": true or false, "reason": "brief explanation"}}
"""
        result = await model.generate(
            grading_prompt,
            config=GenerateConfig(
                response_schema=ResponseSchema(
                    name="plan_verdict",
                    json_schema=json_schema(PlanVerdict),
                    description="Plan verdict: pass/fail with reason",
                    strict=True,
                ),
                temperature=0,
                seed=42,
            ),
        )
        try:
            verdict = PlanVerdict.model_validate_json(_extract_json_text(result.completion))
        except Exception as e:
            return Score.unscored(
                explanation=result.completion,
                metadata={"unscored_reason": "plan_verdict_parse_failure", "detail": str(e)},
            )
        return Score(
            value="pass" if verdict.pass_ else "fail",
            answer=target.text,
            explanation=verdict.reason,
            metadata={"pass": verdict.pass_, "reason": verdict.reason},
        )

    return score


@task
def plan_review_task():
    return Task(
        dataset=MemoryDataset(
            [
                Sample(
                    id=RUN_ID,
                    input=json.dumps(
                        {"owner_request": OWNER_REQUEST, "dag_spec": DAGSPEC},
                        ensure_ascii=False,
                    ),
                    target=json.dumps({"owner_request": OWNER_REQUEST}, ensure_ascii=False),
                )
            ]
        ),
        scorer=plan_verdict_scorer(),
    )
