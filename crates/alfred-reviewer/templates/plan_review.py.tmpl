#!/usr/bin/env python3
"""Inspect task definition — generated by alfred-reviewer (R2 plan review).

Runs the PlanVerdict scorer: judges whether a DagSpec faithfully decomposes
an OwnerRequest. Pure scorer eval — no sandbox, no agent. The reviewer model
is the eval's main model (grader 角色缺省即主模型)。
"""

import json
import re

from pydantic import BaseModel, Field
from inspect_ai import Task, task
from inspect_ai.dataset import MemoryDataset, Sample
from inspect_ai.model import GenerateConfig, ResponseSchema, get_model
from inspect_ai.scorer import Score, accuracy, scorer, stderr
from inspect_ai.util import json_schema

# ---- alfred-injected configuration (tokens replaced by alfred-reviewer) ----
# 字符串 token 注入的是 JSON 字符串字面量（值语义一致），json.loads 还原对象。
OWNER_REQUEST = json.loads(__OWNER_REQUEST_JSON__)
DAGSPEC = json.loads(__DAGSPEC_JSON__)
RUN_ID = __RUN_ID_JSON__
# P2 修复：审查者全可见（§2.4）——会话文档 + 属主消息（无治理上下文时为 None）。
_SESSION_DOC_RAW = __SESSION_DOC_JSON__
SESSION_DOC = None if _SESSION_DOC_RAW == "null" else json.loads(_SESSION_DOC_RAW)
_OWNER_MESSAGE_RAW = __OWNER_MESSAGE_JSON__
OWNER_MESSAGE = None if _OWNER_MESSAGE_RAW == "null" else json.loads(_OWNER_MESSAGE_RAW)




def _extract_json_text(text: str) -> str:
    """从模型输出中提取 JSON 文本（容忍 markdown 代码围栏/前后杂文）。

    zhipu 等网关忽略 json_schema 时会返回自由文本——强提示下仍可能用
    ```json 围栏包裹。这是解析健壮性（Pydantic 校验前），不是 provider
    专属字段拼装。先试原文，再试剥围栏，最后试首个 {...} 平衡块。
    """
    candidates = [text.strip()]
    m = re.search(r"```(?:json)?\s*(.*?)```", text, re.S)
    if m:
        candidates.append(m.group(1).strip())
    for cand in candidates:
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end > start:
        cand = text[start : end + 1]
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    return text

class PlanVerdict(BaseModel):
    pass_: bool = Field(alias="pass")
    reason: str


def _try_parse_verdict(text: str) -> PlanVerdict | None:
    """解析模型输出为 PlanVerdict；空/非法返回 None（供评分器兜底重试）。"""
    try:
        return PlanVerdict.model_validate_json(_extract_json_text(text))
    except Exception:
        return None


@scorer(metrics=[accuracy(), stderr()])
def plan_verdict_scorer():
    async def score(state, target):
        # 主模型 = 审查者模型（eval --model）
        model = get_model()
        config = GenerateConfig(
            response_schema=ResponseSchema(
                name="plan_verdict",
                json_schema=json_schema(PlanVerdict),
                description="Plan verdict: pass/fail with reason",
                strict=True,
            ),
            temperature=0,
            seed=42,
        )
        grading_prompt = f"""You are a plan VERIFIER, not a planner. Your ONLY task is to judge whether the given plan faithfully serves the owner's request. You must NOT modify, fix, or rewrite the plan, and you must NOT output a new plan. Output ONLY the JSON verdict.

[BEGIN DATA]
[Owner Request]: {json.dumps(OWNER_REQUEST, ensure_ascii=False)}
[Plan (DagSpec)]: {json.dumps(DAGSPEC, ensure_ascii=False)}
[Session Doc (prior context)]: {json.dumps(SESSION_DOC, ensure_ascii=False) if SESSION_DOC is not None else "none"}
[Owner Latest Message]: {json.dumps(OWNER_MESSAGE, ensure_ascii=False) if OWNER_MESSAGE is not None else "none"}
[END DATA]

The session doc and the owner's latest message are context ONLY: they record prior feedback so you can tell whether the current plan satisfies the owner's actual intent. They do not change your verdict shape.

Decide: does the plan faithfully serve the owner request?
- every requirement in the owner request must be addressed by the plan;
- the plan must not do things the owner did not ask for.

Respond ONLY with a JSON object of exactly this shape:
{{"pass": true or false, "reason": "brief explanation"}}
"""
        result = await model.generate(grading_prompt, config=config)
        verdict = _try_parse_verdict(result.completion)
        if verdict is None:
            # 兜底：上下文干扰（如属主补充被误读为"要我修计划"）导致空/非 JSON 输出时，
            # 退化为最小判分提示重试一次（仍只判，不修）。审查者已见过完整上下文。
            fallback = f"""You are a plan VERIFIER. Judge whether the plan faithfully serves the owner request. Output ONLY a JSON object of exactly this shape: {{"pass": true or false, "reason": "brief explanation"}}

[Owner Request]: {json.dumps(OWNER_REQUEST, ensure_ascii=False)}
[Plan (DagSpec)]: {json.dumps(DAGSPEC, ensure_ascii=False)}
"""
            result = await model.generate(fallback, config=config)
            verdict = _try_parse_verdict(result.completion)
        if verdict is None:
            return Score.unscored(
                explanation=result.completion,
                metadata={
                    "unscored_reason": "plan_verdict_parse_failure",
                    "detail": "empty or invalid model output after retry",
                },
            )
        return Score(
            value="pass" if verdict.pass_ else "fail",
            answer=target.text,
            explanation=verdict.reason,
            metadata={"pass": verdict.pass_, "reason": verdict.reason},
        )

    return score


@task
def plan_review_task():
    return Task(
        dataset=MemoryDataset(
            [
                Sample(
                    id=RUN_ID,
                    input=json.dumps(
                        {
                            "owner_request": OWNER_REQUEST,
                            "dag_spec": DAGSPEC,
                            "session_doc": SESSION_DOC,
                            "owner_message": OWNER_MESSAGE,
                        },
                        ensure_ascii=False,
                    ),
                    target=json.dumps({"owner_request": OWNER_REQUEST}, ensure_ascii=False),
                )
            ]
        ),
        scorer=plan_verdict_scorer(),
    )
