#!/usr/bin/env python3
"""Planner agent task (R6b) — converse/maintain in a network-none docker sandbox.

Runs pi inside the planner sandbox (ws full RO + /inputs ro + /outputs rw) and
relays its model calls through `sandbox_agent_bridge` to the host-side Inspect
model (the planner provider). The container has no external network and holds
no real credentials: pi's `~/.pi/agent/models.json` points at the bridge proxy
with a dummy `sk-none` key.

  follows the converse schema prompt (two-branch: graph-building instruction
  sequence or owner reply, copied verbatim from alfred-planner converse.rs) and
  writes EITHER the build-instruction JSON array to /outputs/instructions.json
  OR the owner reply text to /outputs/reply.txt (exactly one).
MODE == "maintain": pi reads /inputs/session.json + /inputs/trigger.json and
  writes the updated session doc JSON to /outputs/session.json.
  follows the converse schema prompt (graph-building instruction sequence, copied
  verbatim from alfred-planner converse.rs) and writes the build-instruction JSON
  array to /outputs/instructions.json.
MODE == "maintain": pi reads /inputs/session.json + /inputs/trigger.json and
  writes the updated session doc JSON to /outputs/session.json.

The AGT write-denial extension (`-e /tmp/.agt/agt-policy.ts`) is loaded when
AGT_EXT is non-empty; policy and audit paths default to
/tmp/.agt/{policy.json, audit/audit.jsonl}.
"""

import json
import time

from inspect_ai import Task, task
from inspect_ai.agent import sandbox_agent_bridge
from inspect_ai.dataset import MemoryDataset, Sample
from inspect_ai.model import (
    ChatCompletionChoice,
    ChatMessageAssistant,
    ModelOutput,
)
from inspect_ai.solver import solver
from inspect_ai.util import (
    ExecCompleted,
    ExecRemoteStreamingOptions,
    ExecStdout,
    sandbox,
    store,
)

# ---- alfred-injected configuration (tokens replaced by alfred-planner task_gen) ----
COMPOSE_FILE = __COMPOSE_FILE_JSON__
MODE = __MODE_JSON__
SYSTEM_PROMPT = __SYSTEM_PROMPT_JSON__
DRIVER_PROMPT = __DRIVER_PROMPT_JSON__
OUTPUT_FILE = __OUTPUT_FILE_JSON__
OUTPUT_FILE_ALT = __OUTPUT_FILE_ALT_JSON__
AGT_EXT = __AGT_EXT_JSON__
AGT_POLICY_PATH = __AGT_POLICY_PATH_JSON__
AGT_AUDIT_PATH = __AGT_AUDIT_PATH_JSON__
PORT_BASE = int(__PORT_BASE__)
PI_MODEL = __PI_MODEL_JSON__
WORKSPACE_DIR = __WORKSPACE_DIR_JSON__
SANDBOX_USER = __SANDBOX_USER_JSON__
RUN_ID = __RUN_ID_JSON__
SETTLE_GRACE_SECONDS = float(__SETTLE_GRACE_SECONDS__)


def _models_json(port: int) -> dict:
    return {
        "providers": {
            "inspect-bridge": {
                "baseUrl": f"http://localhost:{port}/v1",
                "api": "openai-completions",
                "apiKey": "sk-none",
                "models": [
                    {
                        "id": "inspect",
                        "compat": {
                            "supportsDeveloperRole": False,
                            "supportsReasoningEffort": False,
                        },
                    }
                ],
            }
        }
    }


async def _write_models_json(sbox, port: int) -> None:
    """Write ~/.pi/agent/models.json pointing at the bridge (dummy key).

    pi 只认 models.json 做 provider 重定向（不读 OPENAI_BASE_URL 类 env）。
    """
    await sbox.exec(["mkdir", "-p", "/root/.pi/agent"])
    content = json.dumps(_models_json(port), indent=2)
    await sbox.exec(
        ["bash", "-c", "cat > /root/.pi/agent/models.json <<'PIE'\n" + content + "\nPIE"]
    )


async def _respond_extension_ui(proc, msg: dict) -> None:
    """Auto-answer pi extension UI dialogs (select/confirm/input/editor).

    Same policy as the executor task: auto-accept — the sandbox has no external
    network and only ws (ro) + /inputs (ro) + /outputs (rw) are mounted, so
    dialogs cannot leak or escalate. AGT tool-permission interception (DenyWrite)
    is handled by pi itself via `-e`.
    """
    method = msg.get("method")
    req_id = msg.get("id")
    if method == "select":
        options = msg.get("options") or []
        if options:
            resp = {"type": "extension_ui_response", "id": req_id, "value": options[0]}
        else:
            resp = {"type": "extension_ui_response", "id": req_id, "cancelled": True}
    elif method == "confirm":
        resp = {"type": "extension_ui_response", "id": req_id, "confirmed": True}
    else:  # input / editor
        resp = {"type": "extension_ui_response", "id": req_id, "value": ""}
    await proc.write_stdin(json.dumps(resp) + "\n")


async def _drive_pi(proc, prompt: str) -> tuple[bool, int | None]:
    """Drive pi RPC: send the task prompt, then process events until settled.

    Protocol (pi docs/rpc.md): JSONL over stdin/stdout, LF-only framing.
    Commands → stdin; events → stdout. `agent_settled` means the session-level
    run is fully settled. After settle we close stdin (EOF) so pi exits
    cleanly; a settle_grace backstop kills a lingering process.

    Returns (settled, exit_code). exit_code is None if the process was killed
    or the loop ended without an ExecCompleted event.
    """
    await proc.write_stdin(json.dumps({"type": "prompt", "message": prompt}) + "\n")

    settled = False
    exit_code = None
    buffer = ""
    settled_at: float | None = None
    async for event in proc:
        if isinstance(event, ExecStdout):
            buffer += event.data
            lines = buffer.split("\n")
            buffer = lines.pop()
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    # non-JSON progress line (e.g. pi banner) — ignore
                    continue
                kind = msg.get("type")
                if kind == "extension_ui_request":
                    await _respond_extension_ui(proc, msg)
                elif kind == "agent_settled":
                    settled = True
                    settled_at = time.monotonic()
                    # agent done; EOF lets the RPC server exit cleanly
                    await proc.close_stdin()
        elif isinstance(event, ExecCompleted):
            exit_code = event.exit_code
            break

        if settled and settled_at is not None and (time.monotonic() - settled_at) > SETTLE_GRACE_SECONDS:
            # pi did not exit on EOF — kill rather than hang until the sample
            # time limit.
            await proc.kill()
            break

    return settled, exit_code


@solver
def planner_agent():
    async def solve(state, generate):
        # per-sample bridge port (inspect_swe pattern: increment from store)
        port = store().get("planner_model_port", PORT_BASE - 1) + 1
        store().set("planner_model_port", port)

        async with sandbox_agent_bridge(port=port) as bridge:
            sbox = sandbox()
            await _write_models_json(sbox, port)

            env = {"PI_OFFLINE": "1", "HOME": "/root"}
            if AGT_EXT:
                env["AGT_POLICY_PATH"] = AGT_POLICY_PATH
                env["AGT_AUDIT_PATH"] = AGT_AUDIT_PATH

            cmd = ["pi", "--mode", "rpc", "--no-session", "--model", PI_MODEL]
            if AGT_EXT:
                cmd += ["-e", AGT_EXT]
            proc = await sbox.exec_remote(
                cmd=cmd,
                options=ExecRemoteStreamingOptions(
                    cwd=WORKSPACE_DIR,
                    env=env,
                    user=SANDBOX_USER or None,
                    concurrency=False,
                    stdin_open=True,
                ),
                stream=True,
            )
            # converse two-branch: exactly one of [instructions.json, reply.txt]
            # must be written (both/neither is an error).
            output_candidates = [OUTPUT_FILE]
            if OUTPUT_FILE_ALT:
                output_candidates.append(OUTPUT_FILE_ALT)
            produced_path = None
            produced_text = None
            for p in output_candidates:
                out = await sbox.exec(["cat", p])
                if out.success and out.stdout.strip():
                    if produced_path is not None:
                        raise RuntimeError(
                            f"planner pi wrote both {produced_path} and {p} (两分支只能二选一)"
                        )
                    produced_path, produced_text = p, out.stdout
            if produced_path is None:
                raise RuntimeError(
                    f"planner pi did not write any of {', '.join(output_candidates)}"
                )
            state.output = ModelOutput(
                model="planner-output-collector",
                choices=[
                    ChatCompletionChoice(
                        message=ChatMessageAssistant(content=produced_text),
                        stop_reason="stop",
                    )
                ],
            )
            out = await sbox.exec(["cat", OUTPUT_FILE])
            if not out.success or not out.stdout.strip():
                raise RuntimeError(f"planner pi did not write {OUTPUT_FILE}")
            state.output = ModelOutput(
                model="planner-output-collector",
                choices=[
                    ChatCompletionChoice(
                        message=ChatMessageAssistant(content=out.stdout),
                        stop_reason="stop",
                    )
                ],
            )
        return state

    return solve


@task
def planner_task():
    return Task(
        dataset=MemoryDataset([Sample(id=RUN_ID, input=MODE)]),
        solver=[planner_agent()],
        sandbox=("docker", COMPOSE_FILE),
    )
