def _models_json(port: int) -> dict:
    model_entry = {
        "id": "inspect",
        "compat": {
            "supportsDeveloperRole": False,
            "supportsReasoningEffort": False,
        },
    }
    if CONTEXT_WINDOW is not None:
        # 声明容量透传（2026-09-26 用户指令）：pi 自身缺省会回落
        # 128000/16384——声明时必须让 pi 看到真实容量（桥仍强制
        # max_tokens=MAX_TOKENS，两侧一致）。
        model_entry["contextWindow"] = CONTEXT_WINDOW
        model_entry["maxTokens"] = MAX_TOKENS
    return {
        "providers": {
            "inspect-bridge": {
                "baseUrl": f"http://localhost:{port}/v1",
                "api": "openai-completions",
                "apiKey": "sk-none",
                "models": [model_entry],
            }
        }
    }


async def _write_models_json(sbox, port: int) -> None:
    """Write ~/.pi/agent/models.json pointing at the bridge (dummy key).

    pi 只认 models.json 做 provider 重定向（不读 OPENAI_BASE_URL 类 env）。
    """
    await sbox.exec(["mkdir", "-p", "/root/.pi/agent"])
    content = json.dumps(_models_json(port), indent=2)
    await sbox.exec(
        ["bash", "-c", "cat > /root/.pi/agent/models.json <<'PIE'\n" + content + "\nPIE"]
    )


async def _respond_extension_ui(proc, msg: dict) -> None:
    """Auto-answer pi extension UI dialogs (select/confirm/input/editor).

    Same policy as the old eval task: auto-accept — the sandbox has no external
    network and only the workspace is mounted, so dialogs cannot leak or escalate.
    """
    method = msg.get("method")
    req_id = msg.get("id")
    if method == "select":
        options = msg.get("options") or []
        if options:
            resp = {"type": "extension_ui_response", "id": req_id, "value": options[0]}
        else:
            resp = {"type": "extension_ui_response", "id": req_id, "cancelled": True}
    elif method == "confirm":
        resp = {"type": "extension_ui_response", "id": req_id, "confirmed": True}
    else:  # input / editor
        resp = {"type": "extension_ui_response", "id": req_id, "value": ""}
    await proc.write_stdin(json.dumps(resp) + "\n")

async def _drive_pi(proc, prompt: str, session_info: dict) -> tuple[bool, int | None]:
    """Drive pi RPC: send the task prompt, then process events until settled.

    Protocol (pi docs/rpc.md): JSONL over stdin/stdout, LF-only framing.
    Commands → stdin; events → stdout. `agent_settled` means the session-level
    run is fully settled. After settle we close stdin (EOF) so pi exits
    cleanly; a settle_grace backstop kills a lingering process.

    Native session identity: a `get_state` command is issued at startup
    (before the prompt) and its response carries pi's assigned
    sessionFile/sessionId into `session_info` (W08 acceptance: identity is
    assigned at RPC startup, before any prompt/model call; the session file
    itself is only persisted after the first assistant message, so identity
    and on-disk existence are recorded separately — see `_session_record`).
    The exact path comes from the RPC response; no directory scanning, no
    guessing the latest file.

    Returns (settled, exit_code). exit_code is None if the process was killed
    or the loop ended without an ExecCompleted event.
    """
    # 身份取回：启动即查（先于 prompt）——W08 phase A 实测无 prompt 时
    # get_state 已返回已分配的 sessionFile/sessionId；id 关联响应。
    await proc.write_stdin(
        json.dumps({"id": "alfred-state", "type": "get_state"}) + "\n"
    )
    await proc.write_stdin(json.dumps({"type": "prompt", "message": prompt}) + "\n")

    settled = False
    exit_code = None
    buffer = ""
    settled_at: float | None = None
    async for event in proc:
        if isinstance(event, ExecStdout):
            buffer += event.data
            lines = buffer.split("\n")
            buffer = lines.pop()
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    # non-JSON progress line (e.g. pi banner) — ignore
                    continue
                kind = msg.get("type")
                if kind == "response":
                    # get_state 响应：登记真实分配的原生 session 身份（只认
                    # 实测字段；不造默认身份，不以身份冒称文件存在）。
                    if (
                        msg.get("id") == "alfred-state"
                        and msg.get("command") == "get_state"
                        and msg.get("success")
                    ):
                        data = msg.get("data") or {}
                        if isinstance(data.get("sessionFile"), str) and isinstance(
                            data.get("sessionId"), str
                        ):
                            session_info["file"] = data["sessionFile"]
                            session_info["id"] = data["sessionId"]
                elif kind == "extension_ui_request":
                    await _respond_extension_ui(proc, msg)
                elif kind == "agent_settled":
                    settled = True
                    settled_at = time.monotonic()
                    # agent done; EOF lets the RPC server exit cleanly
                    await proc.close_stdin()
        elif isinstance(event, ExecCompleted):
            exit_code = event.exit_code
            break

        if settled and settled_at is not None and (time.monotonic() - settled_at) > SETTLE_GRACE_SECONDS:
            # pi did not exit on EOF — kill rather than hang until the sample
            # time limit.
            await proc.kill()
            break

    return settled, exit_code


async def _cleanup_running_projects() -> None:
    """兜底清理：把 Inspect 仍登记的 compose 项目逐个 down（须在 shield 内调用）。

    sample_init 被 fail_after 中途取消时，raw_envs 保持 None，但 project_startup
    已把项目登记进 running_projects()——sample_init 自身 except 里的清理同样被
    取消传播打断，下不了容器。遍历登记表逐个 compose down，容器不泄漏。
    """
    for project in list(running_projects()):
        await project_cleanup(project, quiet=True)

def _record_project(raw_envs: dict) -> None:
    """把 sample_init 实际创建的 compose 项目身份落盘（孤儿精确回收依据）。

    Inspect 项目名 = 基座 + 随机 uuid 后缀（`inspect-<base>-i<6hex>`），只有
    本驱动进程知道确切值；被不可捕获信号（SIGKILL）孤儿化后，任何前缀/全局
    推断都无法精确定位（基座跨 run 共享）。sample_init 一返回即写：项目名 +
    compose 文件 + 本进程 pid/解释器（回收方用同一解释器调 Inspect
    project_cleanup）。sample_init 返回前被杀无记录——残余窗口由下次恢复的
    审计如实区分，不猜项目名。
    """
    env = raw_envs.get("default")
    project = getattr(env, "_project", None)
    name = getattr(project, "name", None)
    if not isinstance(name, str) or not name:
        print("[alfred-driver] project record skipped: no project identity", flush=True)
        return
    record = {
        "event": "project",
        "project": name,
        "task_name": TASK_NAME,
        "compose_file": getattr(project, "config", None) or COMPOSE_FILE,
        "pid": os.getpid(),
        "python": sys.executable,
        "recorded_at": time.time(),
    }
    path = Path(DONE_MARKER).parent / "driver.project.json"
    with open(path, "w") as f:
        json.dump(record, f)


def _workspace_snapshot(root):
    files = {}
    for directory, dirs, names in os.walk(root):
        dirs[:] = [name for name in dirs if name not in {'.git', '.venv', 'node_modules'}
                   and not (Path(directory) / name).is_symlink()]
        for name in names:
            path = Path(directory) / name
            if path.is_symlink() or not path.is_file():
                continue
            relative = path.relative_to(root).as_posix()
            raw = path.read_bytes()
            files[relative] = {'path': relative, 'size': len(raw),
                               'sha256': hashlib.sha256(raw).hexdigest()}
    return files


async def _prepare_workspace_state(sbox, session_info):
    binding = EVIDENCE_BINDING or {}
    if not binding.get('workspace_state_schema'):
        return
    root = Path(binding['workspace_state_root'])
    import yaml
    compose = yaml.safe_load(Path(COMPOSE_FILE).read_text())
    volumes = compose['services']['default'].get('volumes', [])
    workspace_sources = [v.rsplit(':', 2)[0] for v in volumes
                         if isinstance(v, str) and v.endswith(':/workspace:rw')]
    if workspace_sources != [str(root.resolve())]:
        raise RuntimeError('workspace state binding differs from declared first workspace mount')
    marker = Path(binding['workspace_state_marker'])
    if marker.exists():
        saved = json.loads(marker.read_text())
        if saved.get('run_ref') != binding['run_ref'] or saved.get('schema') != binding['workspace_state_schema']:
            raise RuntimeError('workspace state marker belongs to another binding')
    else:
        # This is dependency restoration, not installation. Only allowlisted
        # paths baked by Dockerfile.case-alfred are reachable through the bind.
        script = r'''
import json, shutil
from pathlib import Path
state = Path('/opt/alfred/workspace-state')
manifest = json.loads((state.parent / 'workspace-state.json').read_text())
if manifest.get('schema') != 'alfred-workspace-state-v1':
    raise RuntimeError('missing matching image workspace-state delivery')
restored = []
for relative in manifest['entries']:
    rel = Path(relative)
    if rel.is_absolute() or '..' in rel.parts or rel.name not in {'.git', '.venv', 'node_modules', 'pnpm-lock.yaml'}:
        raise RuntimeError('invalid image workspace-state path')
    source, target = state / rel, Path('/workspace') / rel
    if target.exists() or target.is_symlink():
        continue  # Sample initial state is authoritative (not overwritten).
    target.parent.mkdir(parents=True, exist_ok=True)
    if source.is_dir():
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)
    restored.append(relative)
print(json.dumps({'schema': manifest['schema'], 'restored': restored}))
'''
        result = await sbox.exec(['python3', '-c', script], timeout=600)
        if not result.success:
            raise RuntimeError('image workspace-state restoration failed: ' + result.stderr)
        required = binding.get('workspace_state_required', [])
        missing = [name for name in required if not (root / name).is_dir()]
        if missing:
            raise RuntimeError('bound image lacks required workspace state: ' + ', '.join(missing))
        saved = json.loads(result.stdout)
        saved['run_ref'] = binding['run_ref']
        saved['initial_files'] = _workspace_snapshot(root)
        with marker.open('x') as handle:
            json.dump(saved, handle, ensure_ascii=False)
    # Exact pre-agent baseline: installation/git bootstrap cannot masquerade
    # as an executor change, including after native retries.
    before = _workspace_snapshot(root.parent)
    snapshot = Path(DONE_MARKER).parent / 'workspace.before.json'
    with snapshot.open('x') as handle:
        json.dump(before, handle, sort_keys=True)
    session_info['workspace_state'] = {'schema': saved['schema'], 'marker': str(marker)}
    # Bind-mount presentation can make the container's git reject the bound
    # repository as dubious ownership even though stat shows uid 0 == euid
    # (NativeVerify diag-case09/probe-case09: rc=128 flapping across runs;
    # `git -c safe.directory=/workspace` always works). The original task
    # environment had usable git at /workspace, so the replay must restore
    # that capability: scope the exact run workspace as trusted in THIS
    # ephemeral container only (never '*', never the host, never the image),
    # then verify git actually works and fail loud otherwise. Runs on every
    # container start, including native retries that reuse the marker, since
    # /etc/gitconfig resets with each fresh container.
    trust = r'''
import json, subprocess
from pathlib import Path
status = None
if Path('/workspace/.git').is_dir():
    def run(*args):
        return subprocess.run(['git', *args], capture_output=True, text=True)
    listed = run('config', '--system', '--get-all', 'safe.directory')
    if listed.returncode not in (0, 1):
        raise RuntimeError('git system config unreadable: ' + listed.stderr)
    if '/workspace' in (listed.stdout or '').splitlines():
        status = 'preexisting'
    else:
        added = run('config', '--system', '--add', 'safe.directory', '/workspace')
        if added.returncode != 0:
            raise RuntimeError('cannot scope exact git trust for /workspace: ' + added.stderr)
        status = 'added'
    probe = run('-C', '/workspace', 'rev-parse', '--is-inside-work-tree')
    if probe.returncode != 0 or probe.stdout.strip() != 'true':
        raise RuntimeError('git unusable at /workspace after exact-path trust: ' + probe.stderr)
print(json.dumps({'git_exact_path_trust': status}))
'''
    trust_result = await sbox.exec(['python3', '-c', trust], timeout=120)
    if not trust_result.success:
        raise RuntimeError('git exact-path trust step failed: ' + trust_result.stderr)
    session_info['workspace_state']['git_exact_path_trust'] = json.loads(trust_result.stdout)['git_exact_path_trust']

async def _inject_runtime_key_inputs(env, session_info: dict) -> None:
    """CASE17-SIGNING: designated secret key into THIS run's sandbox.

    Runs after the sandbox is up and workspace state is prepared, BEFORE the
    agent's first action (bridge/pi start). Target is the exact container of
    this sample_init compose project (uuid project name, label-selected; no
    scanning, no guessing, no config re-render). The key travels through the
    registered channel module (inspect_harness.case17_signing): explicit
    source acquisition, host-side fingerprint pre-check BEFORE any import,
    stdin-piped gpg import, ownertrust, and a real detach-sign warm-up — all
    fail loud, so a run without the signing capability fails for a real
    environmental reason instead of silently producing unsigned commits.
    Private key material never touches disk, the image, logs or TOS; the
    recorded report is public facts only (fpr/uid/container ids).
    """
    binding = EVIDENCE_BINDING or {}
    inputs = binding.get('runtime_key_inputs') or []
    if not inputs:
        return
    import subprocess
    project = getattr(env, '_project', None)
    service = getattr(env, '_service', 'default')
    if project is None:
        raise RuntimeError('runtime key injection needs the run compose project')
    ps = subprocess.run(
        ['docker', 'ps', '-q',
         '--filter', f'label=com.docker.compose.project={project.name}',
         '--filter', f'label=com.docker.compose.service={service}'],
        capture_output=True, text=True, timeout=120,
    )
    cids = (ps.stdout or '').split()
    if ps.returncode != 0 or len(cids) != 1:
        raise RuntimeError(
            f'cannot resolve the exact run container for runtime key injection '
            f'(project={project.name!r}, service={service!r}, found={len(cids)}, '
            f'rc={ps.returncode}): ' + (ps.stderr or '').strip()[:300]
        )
    container_id = cids[0]
    import importlib
    harness_root = os.environ.get('ALFRED_HARNESS_ROOT')
    if not harness_root:
        raise RuntimeError('ALFRED_HARNESS_ROOT missing for runtime key inputs')
    sys.path.insert(0, harness_root)
    reports = []
    for entry in inputs:
        kind = entry.get('kind')
        if kind != 'gpg-secret-key':
            raise RuntimeError(f'unsupported runtime key input kind: {kind!r}')
        module_name = entry.get('module') or 'inspect_harness.case17_signing'
        signing = importlib.import_module(module_name)
        material = signing.acquire_secret_key_bytes(
            entry.get('key_file'), entry.get('gnupg_home'))
        signing.check_material_is_designated(material)
        reports.append(signing.inject_into_container(container_id, material))
    session_info['runtime_key_inputs'] = reports


async def _run_container(session_info: dict) -> None:
    """起容器（Inspect DockerSandboxEnvironment）+ 桥代发 + 驱动容器内 pi。

    `session_info` 由调用方持有：`_drive_pi` 从 get_state 响应填充原生
    session 身份；超时/异常取消后已取到的身份仍保留（启动即查，先于任何
    agent 活动），供 done 记录如实关联。
    """
    raw_envs = None
    session_info["cleanup_status"] = "not_created"
    try:
        raw_envs = await DockerSandboxEnvironment.sample_init(
            TASK_NAME, COMPOSE_FILE, metadata=SANDBOX_METADATA
        )
        session_info["cleanup_status"] = "open"
        _record_project(raw_envs)
        await _prepare_workspace_state(raw_envs['default'], session_info)
        # CASE17-SIGNING: designated signing key enters the exact run sandbox
        # before the agent's first action; failure fails the run loudly.
        await _inject_runtime_key_inputs(raw_envs['default'], session_info)
        # exec_remote 依赖 SandboxEnvironmentProxy（事件记录包装，eval 路径同款）
        envs = {k: SandboxEnvironmentProxy(v) for k, v in raw_envs.items()}
        sandbox_environments_context_var.set(envs)
        sandbox_default_context_var.set("default")

        # bridge 把 pi 请求的 "inspect" 经 model_aliases 解析到本角色模型
        # （带 max_tokens 生成配置）；非 "inspect" 请求走 fallback model。
        async with sandbox_agent_bridge(
            model=BRIDGE_MODEL,
            model_aliases={
                "inspect": get_model(
                    BRIDGE_MODEL.removeprefix("inspect/"),
                    config=GenerateConfig(max_tokens=MAX_TOKENS),
                )
            },
            port=PORT,
        ):
            sbox = sandbox()
            await _write_models_json(sbox, PORT)

            env = {"PI_OFFLINE": "1", "HOME": "/root"}
            if AGT_EXT:
                env["AGT_POLICY_PATH"] = AGT_POLICY_PATH
                env["AGT_AUDIT_PATH"] = AGT_AUDIT_PATH
                if REF_VOLUMES:
                    env["AGT_REF_VOLUMES"] = REF_VOLUMES
            cmd = ["pi", "--mode", "rpc", "--session-dir", CONTAINER_SESSIONS_DIR, "--model", PI_MODEL]
            if AGT_EXT:
                cmd += ["-e", AGT_EXT]
            proc = await sbox.exec_remote(
                cmd=cmd,
                options=ExecRemoteStreamingOptions(
                    cwd=WORKSPACE_DIR,
                    env=env,
                    user=SANDBOX_USER or None,
                    concurrency=False,
                    stdin_open=True,
                ),
                stream=True,
            )
            # 契约 + 挂载翻译锚：锚定 workspace_subdirs[0] 即 /workspace 根，
            # 防契约目录名被字面嵌套（src 嵌套歧义治本）。
            settled, exit_code = await _drive_pi(
                proc, CONTRACT_PROMPT + "\n\n" + MOUNT_ANCHOR, session_info
            )
            if not settled or exit_code != 0:
                raise RuntimeError(f"pi RPC did not settle (exit_code={exit_code})")
    finally:
        # 收尾期先转为可捕获中断不可再打断：shield 只挡取消传播，挡不住默认
        # SIGTERM 处置直接杀进程——SIG_IGN 后 compose down 才能跑完（真正
        # 不可捕获的 SIGKILL 无进程内解法，由下次恢复按精确项目记录回收）。
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        # 清理必须 shield：超时取消（fail_after）时，finally 内的 await 会立即抛
        # CancelledError——shield 保证 compose down 跑完，不泄漏容器。
        try:
            with anyio.CancelScope(shield=True):
                if EVIDENCE_BINDING and EVIDENCE_BINDING.get("collector_entrypoint_ref"):
                    try:
                        if raw_envs is None:
                            raise RuntimeError("task environment unavailable for terminal collection")
                        import importlib
                        harness_root = os.environ.get('ALFRED_HARNESS_ROOT')
                        if not harness_root:
                            raise RuntimeError('ALFRED_HARNESS_ROOT missing for bound collector')
                        sys.path.insert(0, harness_root)
                        module_name, entry_name = EVIDENCE_BINDING['collector_entrypoint_ref'].split(':', 1)
                        collector = getattr(importlib.import_module(module_name), entry_name)

                        session_info["terminal_collection"] = await collector(
                            raw_envs["default"], EVIDENCE_BINDING, RUN_ID,
                        )
                    except Exception as collect_ex:
                        session_info["terminal_collection"] = {
                            "status": "error", "error": str(collect_ex),
                        }
                had_resources = raw_envs is not None or bool(list(running_projects()))
                if raw_envs is not None:
                    await DockerSandboxEnvironment.sample_cleanup(
                        TASK_NAME, COMPOSE_FILE, raw_envs, False
                    )
                else:
                    # sample_init 中途被取消：raw_envs 未赋值，但项目已登记进
                    # running_projects()——兜底遍历登记表逐个 down。
                    await _cleanup_running_projects()
                session_info["cleanup_status"] = "released" if had_resources else "not_created"
        except Exception as cleanup_ex:
            session_info["cleanup_status"] = "error"
            session_info["cleanup_error"] = str(cleanup_ex)
            print(f"[alfred-driver] container cleanup failed: {cleanup_ex}")


def _session_record(session_info: dict) -> dict | None:
    """把 RPC 取得的原生 session 身份关联为 done 记录的 session 字段。

    身份与落盘分开记录（W08 核收：pi `_persist()` 需首条 assistant 消息才
    写盘，身份已分配 ≠ 文件存在）。`host_file` 只经 compose 挂载的固定前缀
    精确映射，前缀不符即 None（不猜）；`file_exists` 只在宿主文件可定位时
    以 isfile 实测断言——不扫描目录、不按时间猜最新、不以身份冒称文件存在。
    """
    if not session_info.get("id") or not session_info.get("file"):
        return None
    rec: dict = {
        "id": session_info["id"],
        "file": session_info["file"],
        "host_file": None,
        "file_exists": None,
    }
    prefix = CONTAINER_SESSIONS_DIR + "/"
    if session_info["file"].startswith(prefix):
        rel = session_info["file"][len(prefix):]
        if rel and not os.path.isabs(rel) and all(part not in ("", ".", "..") for part in rel.split("/")):
            host = os.path.join(SESSIONS_DIR_HOST, rel)
            rec["host_file"] = host
            rec["file_exists"] = os.path.isfile(host)
    return rec


def _write_done(status: str, error: str | None, session_info: dict) -> None:
    doc = {
        "event": "done",
        "status": status,
        "run_id": RUN_ID,
        # 原生 session 关联：null = 未从 RPC 取到身份（如实缺席，不伪造）。
        "session": _session_record(session_info),
        # G1 native_inspect：本执行实际使用的容器环境关联（driver 自己
        # sample_init 起的 compose 项目基座 + compose 文件）+ 外层实验绑定
        # 原文回传（null = 未绑定，如手工 feed 续跑）。
        "environment": {"task_name": TASK_NAME, "compose_file": COMPOSE_FILE},
        "evidence_binding": EVIDENCE_BINDING,
        "terminal_collection": session_info.get("terminal_collection"),
        # CASE17-SIGNING injection report (public facts only; absent when
        # the binding declares no runtime key inputs).
        "runtime_key_inputs": session_info.get("runtime_key_inputs"),
        "cleanup_status": session_info.get("cleanup_status", "not_created"),
        "cleanup_error": session_info.get("cleanup_error"),
    }
    if error:
        doc["error"] = error
    with open(DONE_MARKER, "w") as f:
        json.dump(doc, f)


class _DriverInterrupted(BaseException):
    """可捕获终止（SIGTERM/SIGINT）在事件循环接管窗口之外（anyio.run 启动
    前/退出后）到达时的等价物：进 main 的既有收尾链（shield 清理 + done
    记录），而不是默认处置直接杀进程。事件循环运行期间由
    open_signal_receiver 接管（转取消，同一条收尾链）。
    """

    def __init__(self, signum: int):
        super().__init__(signum)


def _install_early_signal_handlers() -> None:
    def _interrupt(signum, _frame):
        raise _DriverInterrupted(signum)

    signal.signal(signal.SIGTERM, _interrupt)
    signal.signal(signal.SIGINT, _interrupt)


async def _run_with_timeout(session_info: dict) -> None:
    # fail_after 是 async 上下文管理器（同步 with 会 NoEventLoopError）——包一层
    # async 函数再交给 anyio.run。超时后 _run_container 的 finally（shield 清理）
    # 先跑完，再向 main 抛 TimeoutError。
    #
    # 可捕获终止（SIGTERM/SIGINT）同一条收尾链：open_signal_receiver 把信号
    # 转成 interrupt_scope 取消——_run_container 的 shield 清理（Inspect
    # compose down + 项目登记回收）跑完后取消在本层吸收、正常返回，main 按
    # session_info 里的中断事实写 done(status="cancelled")。默认 SIGTERM 处置
    # 会直接杀进程——finally/done 全跳过、容器孤立（case02-a2-r1 宿主取消
    # 事故的孤儿根因）——本层把它拉回既有超时收尾链，不做第二套清理框架。
    #
    # watcher 生命周期 + 异常保型（两处必须的结构约束）：
    # - _run_container 一切出口（正常/异常/超时）都要解除 task group 对信号
    #   watcher 的等待——watcher 永等下一个信号，不解除则 tg 退出永久阻塞
    #   （body 返回了进程却挂死）。出口统一 interrupt_scope.cancel() 机械
    #   解锁：不设中断事实，session_info 不动。
    # - body 异常先捕获暂存、退出 task group 后原样重抛：异常带在飞状态进
    #   tg.__aexit__ 会被 anyio 包成 BaseExceptionGroup，TimeoutError/
    #   RuntimeError 的类型语义被吞，main 按 except 类型路由 timed_out/error
    #   即失效。取消类异常（SIGTERM/SIGINT 取消、fail_after 转换前的取消）
    #   在捕获点区分：已在 scope 吸收，事实在 session_info，不上抛。
    outcome: BaseException | None = None
    with anyio.CancelScope() as interrupt_scope:
        with anyio.open_signal_receiver(signal.SIGTERM, signal.SIGINT) as signals:
            async with anyio.create_task_group() as tg:

                async def _watch_signals() -> None:
                    async for sig in signals:
                        session_info["driver_interrupted"] = signal.Signals(sig).name
                        interrupt_scope.cancel()
                        return

                tg.start_soon(_watch_signals)
                try:
                    with anyio.fail_after(TIME_LIMIT_SECS):
                        await _run_container(session_info)
                except BaseException as exc:
                    outcome = exc
                finally:
                    interrupt_scope.cancel()
    if isinstance(outcome, anyio.get_cancelled_exc_class()):
        # 中断取消：事实在 session_info（main 收尾链按标记落 cancelled）。
        return
    if outcome is not None:
        raise outcome


def main() -> None:
    status = "success"
    error: str | None = None
    # 原生 session 身份容器：_drive_pi 从 get_state 响应填充（启动即查）；
    # 超时/异常路径已取到的身份保留，done 记录如实落盘。
    session_info: dict = {}
    _install_early_signal_handlers()
    try:
        anyio.run(_run_with_timeout, session_info)
    except TimeoutError:
        status = "timed_out"
        error = f"driver timed out after {TIME_LIMIT_SECS:.0f}s"
        print(f"[alfred-driver] {error}", flush=True)
    except _DriverInterrupted as ex:
        # 事件循环接管窗口外的可捕获终止：同 cancelled 语义收尾。
        status = "cancelled"
        error = f"driver interrupted by signal {ex.args[0]} outside the event loop"
        print(f"[alfred-driver] {error}", flush=True)
    except KeyboardInterrupt:
        status = "cancelled"
        error = "driver interrupted (KeyboardInterrupt) outside the event loop"
        print(f"[alfred-driver] {error}", flush=True)
    except Exception as ex:
        status = "error"
        error = str(ex)
        print(f"[alfred-driver] driver failed: {error}", flush=True)
        raise
    finally:
        # 写 done 期间不可被默认 SIGTERM 处置打断：receiver 退出时 asyncio 把
        # 处置恢复为默认——先转 SIG_IGN 再落盘（不可捕获的 SIGKILL 无解）。
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        # 事件循环内的中断已在上层吸收为正常返回：唯一事实源是
        # session_info 的中断标记（先到的时间上限/异常不被覆盖）。
        if status == "success" and session_info.get("driver_interrupted"):
            status = "cancelled"
            error = f"driver interrupted by {session_info['driver_interrupted']}"
        _write_done(status, error, session_info)



if __name__ == "__main__":
    main()
