#!/usr/bin/env python3
"""Inspect task definition — generated by alfred-executor (R1 + R2).

Runs the executor agent (pi) inside a network-none docker sandbox and
relays its model calls through `sandbox_agent_bridge` to the host-side
Inspect model (the executor provider). The container has no external
network and holds no real credentials: pi's `~/.pi/agent/models.json`
points at the bridge proxy with a dummy `sk-none` key.

R2 adds the ExecVerdict scorer (执行审查) into the same eval. 投影物理隔离：
- executor (pi) 只拿 Sample.input = CONTRACT_PROMPT（契约任务描述）；
- scorer 只拿 Sample.target = ACCEPTANCE_CRITERIA（契约验收标准）判 Artifact；
两份资料在模板结构上分离，进程层面隔离（钉死项 §3.1 原文）。
"""

import json
import re
import time

import anyio
from typing import Literal

from pydantic import BaseModel
from inspect_ai import Task, task
from inspect_ai.agent import sandbox_agent_bridge
from inspect_ai.dataset import MemoryDataset, Sample
from inspect_ai.model import (
    ChatCompletionChoice,
    ChatMessageAssistant,
    GenerateConfig,
    ModelOutput,
    ResponseSchema,
    get_model,
)
from inspect_ai.scorer import Score, accuracy, scorer, stderr
from inspect_ai.solver import solver
from inspect_ai.util import (
    ExecCompleted,
    ExecRemoteStreamingOptions,
    ExecStdout,
    json_schema,
    sandbox,
    store,
)

# ---- alfred-injected configuration (tokens replaced by alfred-executor) ----
# 字符串 token 注入的是完整 JSON 字面量——JSON 字符串字面量同时是合法的
# Python 字符串字面量（值语义一致），直接赋值即可；数字 token 注入裸数字。
# 见 alfred-executor task_gen.rs。
COMPOSE_FILE = __COMPOSE_FILE_JSON__
CONTRACT_PROMPT = __CONTRACT_PROMPT_JSON__
ACCEPTANCE_CRITERIA = __ACCEPTANCE_CRITERIA_JSON__
PORT_BASE = int(__PORT_BASE__)
PI_MODEL = __PI_MODEL_JSON__
WORKSPACE_DIR = __WORKSPACE_DIR_JSON__
SANDBOX_USER = __SANDBOX_USER_JSON__
RUN_ID = __RUN_ID_JSON__
SETTLE_GRACE_SECONDS = float(__SETTLE_GRACE_SECONDS__)

# ---- R2 执行审查 scorer（锁死五桩：schema 经 Inspect 抽象 + [BEGIN DATA]
#      中和 + Pydantic 校验 + 失败 unscored + temperature=0/seed 经宿主 Model
#      config）。grader 模型经宿主 `--model-role grader=<reviewer>` 绑定，本
#      文件不写任何 provider 专属字段。 ----
FailureClass = Literal[
    "mechanical",
    "contract_ambiguity",
    "fidelity_dispute",
    "contract_fault",
    "disagreement",
]

def _extract_json_text(text: str) -> str:
    """从模型输出中提取 JSON 文本（容忍 markdown 代码围栏/前后杂文）。

    zhipu 等网关忽略 json_schema 时会返回自由文本——强提示下仍可能用
    ```json 围栏包裹。这是解析健壮性（Pydantic 校验前），不是 provider
    专属字段拼装。先试原文，再试剥围栏，最后试首个 {...} 平衡块。
    """
    candidates = [text.strip()]
    m = re.search(r"```(?:json)?\s*(.*?)```", text, re.S)
    if m:
        candidates.append(m.group(1).strip())
    for cand in candidates:
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end > start:
        cand = text[start : end + 1]
        try:
            json.loads(cand)
            return cand
        except Exception:
            pass
    return text


class ExecVerdict(BaseModel):
    grade: Literal["C", "I"]
    failure_class: FailureClass | None = None
    rationale: str

    def validate_invariant(self):
        if self.grade == "C" and self.failure_class is not None:
            raise ValueError("grade C must have failure_class = None")
        if self.grade == "I" and self.failure_class is None:
            raise ValueError("grade I requires failure_class")


@scorer(metrics=[accuracy(), stderr()])
def exec_verdict_scorer():
    async def score(state, target):
        # grader = 审查者模型（宿主进程；由 spawn_eval --model-role grader= 绑定）
        model = get_model(role="grader")
        artifact = state.output.completion or "(no output)"
        grading_prompt = f"""You are assessing a submitted artifact against acceptance criteria.

[BEGIN DATA]
[Acceptance Criteria]: {target.text}
[Artifact]: {artifact}
[END DATA]

Determine whether the artifact satisfies the acceptance criteria.
Respond ONLY with a JSON object of exactly this shape:
{{"grade": "C" or "I", "failure_class": "mechanical"|"contract_ambiguity"|"fidelity_dispute"|"contract_fault"|"disagreement"|null, "rationale": "brief reason"}}

Rules:
- grade "C" means the artifact satisfies the acceptance criteria; failure_class MUST be null.
- grade "I" means it does not satisfy the criteria; failure_class MUST be one of the enumerated values.
"""
        result = await model.generate(
            grading_prompt,
            config=GenerateConfig(
                response_schema=ResponseSchema(
                    name="exec_verdict",
                    json_schema=json_schema(ExecVerdict),
                    description="Exec verdict: grade C/I, optional failure_class, rationale",
                    strict=True,
                ),
                temperature=0,
                seed=42,
            ),
        )
        try:
            verdict = ExecVerdict.model_validate_json(_extract_json_text(result.completion))
            verdict.validate_invariant()
        except Exception as e:
            return Score.unscored(
                explanation=result.completion,
                metadata={"unscored_reason": "verdict_parse_failure", "detail": str(e)},
            )
        return Score(
            value=verdict.grade,
            answer=artifact,
            explanation=verdict.rationale,
            metadata={
                "failure_class": verdict.failure_class,
                "grade": verdict.grade,
                "rationale": verdict.rationale,
            },
        )

    return score


def _models_json(port: int) -> dict:
    return {
        "providers": {
            "inspect-bridge": {
                "baseUrl": f"http://localhost:{port}/v1",
                "api": "openai-completions",
                "apiKey": "sk-none",
                "models": [
                    {
                        "id": "inspect",
                        "compat": {
                            "supportsDeveloperRole": False,
                            "supportsReasoningEffort": False,
                        },
                    }
                ],
            }
        }
    }


async def _write_models_json(sbox, port: int) -> None:
    """Write ~/.pi/agent/models.json pointing at the bridge (dummy key).

    pi 只认 models.json 做 provider 重定向（不读 OPENAI_BASE_URL 类 env）。
    """
    await sbox.exec(["mkdir", "-p", "/root/.pi/agent"])
    content = json.dumps(_models_json(port), indent=2)
    await sbox.exec(
        ["bash", "-c", "cat > /root/.pi/agent/models.json <<'PIE'\n" + content + "\nPIE"]
    )


async def _respond_extension_ui(proc, msg: dict) -> None:
    """Auto-answer pi extension UI dialogs (select/confirm/input/editor).

    R1 policy: auto-accept — the sandbox has no external network and only
    the workspace is mounted, so dialogs cannot leak or escalate. AGT-based
    tool-permission interception replaces this in R5 (P10).
    """
    method = msg.get("method")
    req_id = msg.get("id")
    if method == "select":
        options = msg.get("options") or []
        if options:
            resp = {"type": "extension_ui_response", "id": req_id, "value": options[0]}
        else:
            resp = {"type": "extension_ui_response", "id": req_id, "cancelled": True}
    elif method == "confirm":
        resp = {"type": "extension_ui_response", "id": req_id, "confirmed": True}
    else:  # input / editor
        resp = {"type": "extension_ui_response", "id": req_id, "value": ""}
    await proc.write_stdin(json.dumps(resp) + "\n")


async def _drive_pi(proc, prompt: str) -> tuple[bool, int | None]:
    """Drive pi RPC: send the task prompt, then process events until settled.

    Protocol (pi docs/rpc.md): JSONL over stdin/stdout, LF-only framing.
    Commands → stdin; events → stdout. `agent_settled` means the session-level
    run is fully settled. After settle we close stdin (EOF) so pi exits
    cleanly; a settle_grace backstop kills a lingering process.

    Returns (settled, exit_code). exit_code is None if the process was killed
    or the loop ended without an ExecCompleted event.
    """
    await proc.write_stdin(json.dumps({"type": "prompt", "message": prompt}) + "\n")

    settled = False
    exit_code = None
    buffer = ""
    settled_at: float | None = None
    async for event in proc:
        if isinstance(event, ExecStdout):
            buffer += event.data
            lines = buffer.split("\n")
            buffer = lines.pop()
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    # non-JSON progress line (e.g. pi banner) — ignore
                    continue
                kind = msg.get("type")
                if kind == "extension_ui_request":
                    await _respond_extension_ui(proc, msg)
                elif kind == "agent_settled":
                    settled = True
                    settled_at = time.monotonic()
                    # agent done; EOF lets the RPC server exit cleanly
                    await proc.close_stdin()
        elif isinstance(event, ExecCompleted):
            exit_code = event.exit_code
            break

        if settled and settled_at is not None and (time.monotonic() - settled_at) > SETTLE_GRACE_SECONDS:
            # pi did not exit on EOF — kill rather than hang until the sample
            # time limit.
            await proc.kill()
            break

    return settled, exit_code


async def _collect_artifact_summary(sbox, cwd: str, max_files: int = 200, max_bytes_per_file: int = 4000) -> str:
    """Collect workspace artifact summary for the scorer.

    投影物理隔离的"产物面"：scorer 判分依据是 pi 在 workspace 产出的文件。
    这里把工作区文件清单 + 内容摘要收进 state.output.completion，scorer 只见
    这个摘要，不见契约 prompt。
    """
    listing = await sbox.exec(
        ["bash", "-c", "find . -type f -not -path './.git/*' | sort"],
        cwd=cwd,
    )
    files = [ln for ln in listing.stdout.split("\n") if ln.strip()]
    if not files:
        return "(no files produced in workspace)"

    parts = []
    total = 0
    for f in files[:max_files]:
        size_r = await sbox.exec(
            ["bash", "-c", f"wc -c < '{f}' 2>/dev/null || echo 0"],
            cwd=cwd,
        )
        size = size_r.stdout.strip()
        content_r = await sbox.exec(
            ["bash", "-c", f"head -c {max_bytes_per_file} '{f}' 2>/dev/null"],
            cwd=cwd,
        )
        content = content_r.stdout
        parts.append(f"--- {f} ({size} bytes) ---\n{content}")
        total += min(len(content), max_bytes_per_file)
        if total > 80_000:
            parts.append("...(artifact summary truncated)")
            break
    return "\n".join(parts)


@solver
def pi_agent():
    async def solve(state, generate):
        # per-sample bridge port (inspect_swe pattern: increment from store)
        port = store().get("pi_model_port", PORT_BASE - 1) + 1
        store().set("pi_model_port", port)

        async with sandbox_agent_bridge(port=port) as bridge:
            sbox = sandbox()
            await _write_models_json(sbox, port)

            proc = await sbox.exec_remote(
                cmd=["pi", "--mode", "rpc", "--no-session", "--model", PI_MODEL],
                options=ExecRemoteStreamingOptions(
                    cwd=WORKSPACE_DIR,
                    env={"PI_OFFLINE": "1", "HOME": "/root"},
                    user=SANDBOX_USER or None,
                    concurrency=False,
                    stdin_open=True,
                ),
                stream=True,
            )
            settled, exit_code = await _drive_pi(proc, CONTRACT_PROMPT)
            if not settled:
                raise RuntimeError(f"pi RPC did not settle (exit_code={exit_code})")

            # R2: 产物摘要 → state.output（scorer 判分的投影；scorer 不见 prompt）
            artifact_summary = await _collect_artifact_summary(sbox, WORKSPACE_DIR)
            state.output = ModelOutput(
                model="artifact-collector",
                choices=[
                    ChatCompletionChoice(
                        message=ChatMessageAssistant(content=artifact_summary),
                        stop_reason="stop",
                    )
                ],
            )
        return state

    return solve


@task
def executor_task():
    return Task(
        dataset=MemoryDataset(
            [Sample(id=RUN_ID, input=CONTRACT_PROMPT, target=ACCEPTANCE_CRITERIA)]
        ),
        solver=[pi_agent()],
        scorer=exec_verdict_scorer(),
        sandbox=("docker", COMPOSE_FILE),
    )
