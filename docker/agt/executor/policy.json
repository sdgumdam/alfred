{
  "apiVersion": "governance.toolkit/v1",
  "name": "alfred-sandbox-minimal",
  "default_action": "allow",
  "deny_on_policy_error": true,
  "rules": [
    {
      "name": "recursive-delete",
      "description": "阻断递归删除（rm -rf 等）——防止清空工作区",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "\\brm\\b[\\s\\S]*-(?:r[fF]|[fF]r)\\b", "flags": "i" }],
      "action": "deny"
    },
    {
      "name": "no-sudo",
      "description": "沙箱内禁用 sudo",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "\\bsudo\\b", "flags": "i" }],
      "action": "deny"
    },
    {
      "name": "host-secret-read",
      "description": "阻断读取宿主侧密钥/凭据文件（.env、ssh、云凭据等）",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        {
          "source": "\\b(cat|less|more|head|tail|sed|awk)\\b[^\\n]*(\\.env(\\.[\\w-]+)?|id_rsa|id_ed25519|\\.ssh|/\\.aws/|/\\.azure/|/\\.kube/|\\.docker/config\\.json|\\.netrc|\\.git-credentials|\\.npmrc)",
          "flags": "i"
        }
      ],
      "action": "deny"
    },
    {
      "name": "workspace-write-only",
      "description": "写/改/移/删目标必须位于 /workspace 内",
      "condition": "tool_name in ['write', 'edit', 'rename', 'delete', 'mkdir', 'move', 'copy', 'create'] and path_escapes_workspace",
      "action": "deny"
    },
    {
      "name": "no-host-path-touch",
      "description": "bash 命令不得引用工作区外的宿主绝对路径（系统工具白名单除外）",
      "condition": "tool_name == 'bash' and command_escapes_workspace",
      "action": "deny"
    }
  ]
}
