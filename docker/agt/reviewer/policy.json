{
  "apiVersion": "governance.toolkit/v1",
  "name": "alfred-reviewer-deny-write",
  "default_action": "allow",
  "deny_on_policy_error": true,
  "rules": [
    {
      "name": "allow-write-verdict-output",
      "description": "放行写审查产出目录（verdict 收割路径；{outputs_dir} 宿主落盘时替换）",
      "condition": "tool_name in ['write', 'edit', 'rename', 'move', 'copy', 'create']",
      "path_prefixes": ["{outputs_dir}"],
      "action": "allow"
    },
    {
      "name": "deny-all-writes",
      "description": "结构性拒绝一切写（reviewer 只读审查 + 唯一产出 verdict；项目根/run/ws 均无写权限）",
      "condition": "tool_name in ['write', 'edit', 'rename', 'delete', 'mkdir', 'move', 'copy', 'create']",
      "action": "deny"
    },
    {
      "name": "allow-write-redirect-verdict-output",
      "description": "放行 bash 写重定向到审查产出目录（占位正则由宿主落盘时替换）",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "{outputs_redirect_allow}", "flags": "i" }],
      "action": "allow"
    },
    {
      "name": "deny-bash-write-redirect",
      "description": "阻断 bash 写重定向到产出目录之外（防 write 被拒后经重定向绕过）",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        { "source": "(?:^|[;|&\\s])>>?\\s*[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])>\\|\\s*[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])<>\\s*[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])tee\\s+(?:-a\\s+)?[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])dd\\b[^|;&<>]*\\bof=[^\\s|;&<>]+", "flags": "i" }
      ],
      "action": "deny"
    },
    {
      "name": "no-sudo",
      "description": "禁用 sudo（最小权限）",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "\\bsudo\\b", "flags": "i" }],
      "action": "deny"
    },
    {
      "name": "no-recursive-delete",
      "description": "阻断递归删除（rm -rf 等）——防止清空工作区",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "\\brm\\b[\\s\\S]*-(?:r[fF]|[fF]r)\\b", "flags": "i" }],
      "action": "deny"
    }
  ]
}
