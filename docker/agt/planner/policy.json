{
  "apiVersion": "governance.toolkit/v1",
  "name": "alfred-planner-unaware",
  "default_action": "allow",
  "deny_on_policy_error": true,
  "rules": [
    {
      "name": "allow-write-to-outputs",
      "description": "产出目录放行（占位符由宿主落盘后按 run 渲染注入）",
      "condition": "tool_name == 'write' or tool_name == 'edit'",
      "path_prefixes": ["{outputs_dir}", "{outputs_dir_rel}"],
      "action": "allow",
      "priority": 40
    },
    {
      "name": "allow-bash-write-outputs",
      "description": "bash 写重定向放行产出目录（重定向/tee 指向产出目录；占位正则由宿主落盘时替换）",
      "condition": "tool_name == 'bash'",
      "command_patterns": [{ "source": "{outputs_redirect_allow}", "flags": "i" }],
      "action": "allow",
      "priority": 34
    },
    {
      "name": "deny-governance-files",
      "description": "路径不在允许的工作范围",
      "condition": "tool_name == 'read' or tool_name == 'write' or tool_name == 'edit'",
      "path_prefixes": ["{run_dir}", "{run_dir_rel}", "{agt_work}"],
      "action": "deny",
      "priority": 36
    },
    {
      "name": "deny-bash-governance-paths",
      "description": "路径不在允许的工作范围",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        { "source": "\\.alfred/runs", "flags": "" },
        { "source": "\\.agt/", "flags": "" },
        { "source": "{run_dir_pattern}(?!(?:/|\\\\)(?:[^/\\\\]*(?:/|\\\\))*planner(?:/|\\\\)outputs(?:/|\\\\|$))", "flags": "" },
        { "source": "\\.\\.[/\\\\]|(?<=[\\s;|&])\\.\\.(?=[\\s;|&]|$)|(?<=[\\s=])~(?:/|\\\\|$)|(?<=[\\s=])\\$(?:HOME\\b|\\{HOME\\})", "flags": "" },
        { "source": "(?:verdict|conversation|audit|run[ _-]?dir)", "flags": "i" }
      ],
      "action": "deny",
      "priority": 38
    },
    {
      "name": "deny-bash-write-family",
      "description": "路径不在允许的工作范围",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        { "source": "(?:^|[;|&\\s])>>?\\s*[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])>>?[^\\s|;&<>]", "flags": "i" },
        { "source": "(?:^|[;|&\\s])(?:[012]>>?|&>>?)\\s*[^\\s|;&<>]+", "flags": "i" },
        { "source": "(?:^|[;|&\\s])tee\\s", "flags": "i" },
        { "source": "(?:^|[;|&\\s])dd\\b[^|;&<>]*\\bof=", "flags": "i" },
        { "source": "(?:^|[;|&\\s])(?:cp|mv|ln|mkdir|rmdir|touch|truncate|chmod|chown)\\b", "flags": "i" },
        { "source": "(?:^|[;|&\\s])rm\\b", "flags": "i" },
        { "source": "(?:^|[;|&\\s])sed\\b[^|;&<>]*-i\\b", "flags": "i" },
        { "source": "\\bsudo\\b", "flags": "i" }
      ],
      "action": "deny",
      "priority": 32
    },
    {
      "name": "deny-write-to-workspace",
      "description": "路径不在允许的工作范围",
      "condition": "tool_name == 'write' or tool_name == 'edit'",
      "path_prefixes": ["{workspace_dir}"],
      "action": "deny",
      "priority": 20
    }
  ]
}
