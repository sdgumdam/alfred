{
  "apiVersion": "governance.toolkit/v1",
  "name": "alfred-planner-unaware",
  "default_action": "allow",
  "deny_on_policy_error": true,
  "rules": [
    {
      "name": "allow-write-to-outputs",
      "description": "产出目录放行（占位符由宿主驱动按 run 渲染注入）",
      "condition": "(tool_name == 'write' or tool_name == 'edit') and (target_path.startswith('__OUTPUTS_DIR__') or target_path.startswith('__OUTPUTS_DIR_REL__'))",
      "action": "allow",
      "priority": 30
    },
    {
      "name": "deny-write-to-workspace",
      "description": "路径不在工作范围",
      "condition": "(tool_name == 'write' or tool_name == 'edit') and target_path.startswith('__WORKSPACE_DIR__')",
      "action": "deny",
      "priority": 20
    },
    {
      "name": "deny-governance-files",
      "description": "路径不在工作范围",
      "condition": "(tool_name == 'read' or tool_name == 'write' or tool_name == 'edit') and (target_path.startswith('__RUNS_DIR__') or target_path.startswith('__RUNS_DIR_REL__') or target_path.startswith('__AGT_WORK__'))",
      "action": "deny",
      "priority": 25
    },
    {
      "name": "deny-bash-governance-paths",
      "description": "路径不在工作范围",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        { "source": "\\.alfred/runs", "flags": "" },
        { "source": "\\.agt/", "flags": "" }
      ],
      "action": "deny",
      "priority": 25
    },
    {
      "name": "deny-bash-write-redirection",
      "description": "路径不在工作范围",
      "condition": "tool_name == 'bash'",
      "command_patterns": [
        { "source": "^(?:[^\\n\"']|\"[^\"]*\"|'[^']*')*?(?:>>?|<<<?)[\\s\\S]*", "flags": "" },
        { "source": "\\bsudo\\b", "flags": "i" },
        { "source": "\\brm\\b[\\s\\S]*-(?:r[fF]|[fF]r)\\b", "flags": "i" }
      ],
      "action": "deny"
    }
  ]
}
