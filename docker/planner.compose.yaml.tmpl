# planner 容器 compose 模板（R6a：三容器挂载矩阵 §1.1 planner 行落码）
#
# 依据：.plans/对齐方案-三容器Agent化.md v2 §1.1 可见范围矩阵 + §二.1 示例。
# 挂载面 = 矩阵 planner 行：ws 全量 ro + OwnerRequest ro + 会话文档(投影) ro +
#   属主本轮消息 ro + 契约(自己写的) ro + AGT 拦写层 ro + 输出卷 rw。
#
# **不挂 conversation.json**——owner↔planner 对话记录是 reviewer 独有挂载
# （矩阵 §1.1 第 6 行 planner=❌；属主原话"审查者比规划者多看到规划者和 owner
# 的对话记录"）。planner 的对话面输入 = 投影会话文档 + 本轮属主消息
# （/inputs/owner_message.txt——P1 修复：容器必须读得到属主消息才能对话，
# converse 容器侧 driver prompt 读它）。
#
# 占位符（R6b/c/d 编排器渲染时替换为 canonicalize 后绝对路径——实施计划 E1/E3：
# 相对路径被 docker 静默变 named volume、colima 只共享 ~）：
#   {ws}            → 持久 ws 宿主目录（~/alfred-runs/<run_id>/ws/）
#   {request_path}  → {run_dir}/request.json
#   {session_path}  → {run_dir}/session.json（投影后会话文档）
#   {owner_message_path} → {run_dir}/planner/inputs/owner_message.txt（属主本轮消息）
#   {trigger_mount} → maintain: `- {abs}:/inputs/trigger.json:ro`；converse: 注释行
#                     （converse 不产 trigger.json，docker 对不存在宿主文件静默建目录，
#                     maintain 后写同名文件撞目录 os error 21——E1 修复）
#   {contract_path} → {run_dir}/contract.json（planner 自己写的契约，只读回看）
#   {agt_dir}       → AGT 策略 + 扩展目录（挂到 /tmp/.agt，ro）
#   {outputs_dir}   → 容器产出挂载（建图指令/答复/DagSpec 写 /outputs，rw）
# 只读参考卷（矩阵"按需 ro"行）由编排器按 SandboxProfile.volumes 动态追加，
# 不在本模板写死。
services:
  default:
    image: "alfred-executor:latest"
    command: "tail -f /dev/null"
    init: true
    network_mode: none
    stop_grace_period: 1s
    volumes:
    - {ws}:/workspace:ro
    - {request_path}:/inputs/request.json:ro
    - {session_path}:/inputs/session.json:ro
    - {owner_message_path}:/inputs/owner_message.txt:ro
    {trigger_mount}
    - {contract_path}:/inputs/contract.json:ro
    - {agt_dir}:/tmp/.agt:ro
    - {outputs_dir}:/outputs
