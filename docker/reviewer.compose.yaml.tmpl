# reviewer 容器 compose 模板（R6a：三容器挂载矩阵 §1.1 reviewer 行落码）
#
# 依据：.plans/对齐方案-三容器Agent化.md v2 §1.1 可见范围矩阵 + §二.1 示例。
# 挂载面 = 矩阵 reviewer 行：ws 全量 ro + OwnerRequest ro + 会话文档 ro +
#   owner↔planner 对话记录 ro + 契约全字段 ro + AGT 拦写层 ro + 输出卷 rw。
#
# **reviewer 是唯一挂 conversation.json 的角色**（矩阵 §1.1 第 6 行 reviewer=✅；
# 属主原话"审查者比规划者多看到规划者和 owner 的对话记录"）。全可见——审查者从
# 对话记录判忠实度（施工清单 §2.4），不依赖摘要投影。
#
# 占位符（R6b/c/d 编排器渲染时替换为 canonicalize 后绝对路径——实施计划 E1/E3）：
#   {ws}               → 持久 ws 宿主目录（~/alfred-runs/<run_id>/ws/）
#   {conversation_path} → {run_dir}/conversation.json（reviewer 独有挂载）
#   {request_path}     → {run_dir}/request.json
#   {session_full_path} → {run_dir}/session.json（完整会话文档真源）
#                       全可见语义：不得与 planner 的投影会话文件同源——
#                       planner 挂 {session_path}（投影后），reviewer 挂真源
#   {dagspec_path}     → 待审计划（DagSpec JSON；计划审查挂，执行审查不挂）
#   {agt_dir}          → AGT 策略 + 扩展目录（挂到 /tmp/.agt，ro）
#   {outputs_dir}      → 容器产出挂载（verdict 写 /outputs，rw）
# 只读参考卷（矩阵"按需 ro"行）与审查记录/verdict 输入（矩阵第 8 行）由编排器
# 按运行期需要动态追加，不在本模板写死。
services:
  default:
    image: "alfred-executor:latest"
    command: "tail -f /dev/null"
    init: true
    network_mode: none
    stop_grace_period: 1s
    volumes:
    - {ws}:/workspace:ro
    - {conversation_path}:/inputs/conversation.json:ro
    - {request_path}:/inputs/request.json:ro
    - {session_full_path}:/inputs/session.json:ro
    - {contract_path}:/inputs/contract.json:ro
    - {dagspec_path}:/inputs/dagspec.json:ro
    - {agt_dir}:/tmp/.agt:ro
    - {outputs_dir}:/outputs
#   {agt_dir}          → AGT 策略 + 扩展目录（挂到 /tmp/.agt，ro）
#   {outputs_dir}      → 容器产出挂载（verdict 写 /outputs，rw）
# 只读参考卷（矩阵"按需 ro"行）与审查记录/verdict 输入（矩阵第 8 行）由编排器
# 按运行期需要动态追加，不在本模板写死。
services:
  default:
    image: "alfred-executor:latest"
    command: "tail -f /dev/null"
    init: true
    network_mode: none
    stop_grace_period: 1s
    volumes:
    - {ws}:/workspace:ro
    - {conversation_path}:/inputs/conversation.json:ro
    - {request_path}:/inputs/request.json:ro
    - {session_full_path}:/inputs/session.json:ro
    - {contract_path}:/inputs/contract.json:ro
    - {agt_dir}:/tmp/.agt:ro
    - {outputs_dir}:/outputs
